{
  "name": "flick-web",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "workspaces": ["landing"],
  "scripts": {
    "dev": "vite",
    "dev:landing": "cd landing && bun run dev",
    "build": "bun run build:landing && bun run build:app",
    "build:landing": "cd landing && bun run build",
    "build:app": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && cd landing && bun run check"
  },
  "dependencies": {
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7",
    "svelte-check": "^4.1.1",
    "typescript": "^5.7.2",
    "vite": "^8"
  }
}
